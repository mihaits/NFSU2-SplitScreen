 }
 
+// SPIKE (6P): the world view table has 12 entries. With g_sharedWorldEntry the extra player views share one entry:
+// before each of them it points at that view and is re-culled into the free buffer space, and the cursor is moved
+// past it so the headlight re-cull doesn't overwrite it. The cursor goes back at the next player view.
+static uint32_t g_cullBase;
+static void WorldProbe(int viewId) {
+    uint8_t* world = g_worldViews;
+    if (!world || !g_worldProbe || viewId != 1 || g_mmFrame % 300) return;
+    int n = *reinterpret_cast<int*>(world + WORLD_VIEW_COUNT);
+    uint32_t cur = *reinterpret_cast<uint32_t*>(world + 0x6C8);
+    char line[512];
+    int len = wsprintfA(line, "probe: %d entries, cull buffer %u / %u bytes:", n, cur - 0x876DE0u, 0x8832C0u - 0x876DE0u);
+    for (int i = 0; i < n && i < 12; ++i) {
+        uint8_t* e = world + i * 0x90;
+        View* v = *reinterpret_cast<View**>(e + 0x40);
+        len += wsprintfA(line + len, " v%d=%u", v ? v->id : -1,
+                         *reinterpret_cast<uint32_t*>(e + 0x4C) - *reinterpret_cast<uint32_t*>(e + 0x48));
+    }
+    Log("%s", line);
+}
+static void SharedEntryFor(int k) {
+    uint8_t* world = g_worldViews;
+    if (!g_sharedWorldEntry || !world) return;
+    uint32_t& cursor = *reinterpret_cast<uint32_t*>(world + 0x6C8);
+    if (k == 0) g_cullBase = cursor;
+    else if (g_cullBase) cursor = g_cullBase;
+    if (k < 2) return;
+    int n = *reinterpret_cast<int*>(world + WORLD_VIEW_COUNT);
+    for (int i = 0; i < n && i < 12; ++i) {
+        uint8_t* e = world + i * 0x90;
+        View*& owner = *reinterpret_cast<View**>(e + 0x40);
+        if (!owner || owner->id < 5 || owner->id > 8) continue;
+        View& v = GetView(kPlayerViewId[k]);
+        owner = &v;
+        RecullHeadlightView(v);                      // generic: finds the entry by its view
+        cursor = *reinterpret_cast<uint32_t*>(e + 0x4C);
+        return;
+    }
+}
+
